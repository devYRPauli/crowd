{
  "name": "crowd",
  "version": "1.0.0",
  "private": true,
  "description": "CROWD — Constraint-aware Rehearsal and Optimisation of Walking Dynamics. Design a space in 3D, then rehearse how people move through it.",
  "keywords": [
    "crowd-simulation",
    "pedestrian-dynamics",
    "egress",
    "evacuation",
    "floor-plan",
    "orca",
    "fast-marching",
    "threejs",
    "react",
    "typescript"
  ],
  "homepage": "https://devyrpauli.github.io/crowd/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devYRPauli/crowd.git"
  },
  "bugs": "https://github.com/devYRPauli/crowd/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "smoke": "vite build && node scripts/smoke.mjs",
    "bench": "vite-node scripts/benchmark.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "globals": "^16.0.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.0"
  }
}
